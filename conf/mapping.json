{
  "settings": {
    "index": {
      "number_of_shards": 2,
      "number_of_replicas": 0,
      "refresh_interval": "1000ms"
    },
    "similarity": {
      "scripted_sim": {
        "type": "scripted",
        "script": {
          "source": "double idf = Math.log(1+(field.docCount-term.docFreq+0.5)/(term.docFreq + 0.5))/Math.log(1+((field.docCount-0.5)/1.5)); return query.boost * idf * Math.min(doc.freq, 1);"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "lat_lon": {
        "type": "geo_point",
        "store": "true"
      },
      "retrieval_unit_id": {
        "type": "keyword",
        "store": true
      },
      "doc_id": {
        "type": "keyword",
        "store": true
      },
      "kb_id": {
        "type": "keyword",
        "store": true
      },
      "content_hash": {
        "type": "keyword",
        "store": true
      },
      "source_revision": {
        "type": "keyword",
        "store": true
      },
      "subdocument_id": {
        "type": "keyword",
        "store": true
      },
      "element_ids": {
        "type": "keyword",
        "store": true
      },
      "logical_unit_ids": {
        "type": "keyword",
        "store": true
      },
      "unit_type": {
        "type": "keyword",
        "store": true
      },
      "language": {"type": "keyword", "store": true},
      "document_text_quality": {"type": "float", "store": true},
      "document_order_quality": {"type": "float", "store": true},
      "document_structure_quality": {"type": "float", "store": true},
      "document_overall_quality": {"type": "float", "store": true},
      "text_anomaly_count": {"type": "integer", "store": true},
      "has_text_anomaly": {"type": "boolean", "store": true},
      "quality_multiplier": {"type": "float", "store": true},
      "projection_version": {
        "type": "keyword",
        "store": true
      },
      "tokenizer_version": {
        "type": "keyword",
        "store": true
      },
      "token_num": {
        "type": "integer",
        "store": true
      },
      "canonical_artifact_ref": {
        "type": "object",
        "dynamic": false,
        "properties": {
          "registry_id": {"type": "keyword", "store": true},
          "artifact_hash": {"type": "keyword", "store": true},
          "schema_version": {"type": "keyword", "store": true},
          "serialization_version": {"type": "keyword", "store": true},
          "content_encoding": {"type": "keyword", "store": true},
          "stored_hash": {"type": "keyword", "store": true},
          "stored_byte_size": {"type": "long", "store": true}
        }
      },
      "context_path": {
        "type": "nested",
        "dynamic": false,
        "properties": {
          "id": {"type": "keyword", "store": true},
          "type": {"type": "keyword", "store": true},
          "label": {"type": "keyword", "index": false, "store": true},
          "source": {"type": "keyword", "store": true},
          "confidence": {"type": "float", "store": true}
        }
      },
      "source_anchors": {
        "type": "nested",
        "dynamic": false,
        "properties": {
          "element_id": {"type": "keyword", "store": true},
          "location_source": {"type": "keyword", "store": true},
          "page": {"type": "integer", "store": true},
          "x0": {"type": "float", "store": true},
          "y0": {"type": "float", "store": true},
          "x1": {"type": "float", "store": true},
          "y1": {"type": "float", "store": true},
          "start_char": {"type": "integer", "store": true},
          "end_char": {"type": "integer", "store": true},
          "line_start": {"type": "integer", "store": true},
          "line_end": {"type": "integer", "store": true}
        }
      }
    },
    "date_detection": "true",
    "dynamic_templates": [
      {
        "int": {
          "match": "*_int",
          "mapping": {
            "type": "integer",
            "store": "true"
          }
        }
      },
      {
        "ulong": {
          "match": "*_ulong",
          "mapping": {
            "type": "unsigned_long",
            "store": "true"
          }
        }
      },
      {
        "long": {
          "match": "*_long",
          "mapping": {
            "type": "long",
            "store": "true"
          }
        }
      },
      {
        "short": {
          "match": "*_short",
          "mapping": {
            "type": "short",
            "store": "true"
          }
        }
      },
      {
        "numeric": {
          "match": "*_flt",
          "mapping": {
            "type": "float",
            "store": true
          }
        }
      },
      {
        "tks": {
          "match": "*_tks",
          "mapping": {
            "type": "text",
            "similarity": "scripted_sim",
            "analyzer": "whitespace",
            "store": true
          }
        }
      },
      {
        "ltks": {
          "match": "*_ltks",
          "mapping": {
            "type": "text",
            "analyzer": "whitespace",
            "store": true
          }
        }
      },
      {
        "kwd": {
          "match_pattern": "regex",
          "match": "^(.*_(kwd|id|ids|uid|uids)|uid|id)$",
          "mapping": {
            "type": "keyword",
            "similarity": "boolean",
            "store": true
          }
        }
      },
      {
        "dt": {
          "match_pattern": "regex",
          "match": "^.*(_dt|_time|_at)$",
          "mapping": {
            "type": "date",
            "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||yyyy-MM-dd_HH:mm:ss",
            "store": true
          }
        }
      },
      {
        "nested": {
          "match": "*_nst",
          "mapping": {
            "type": "nested"
          }
        }
      },
      {
        "object": {
          "match": "*_obj",
          "mapping": {
            "type": "object",
            "dynamic": "true"
          }
        }
      },
      {
        "string": {
          "match_pattern": "regex",
          "match": "^.*_(with_weight|list)$",
          "mapping": {
            "type": "text",
            "index": "false",
            "store": true
          }
        }
      },
      {
        "rank_feature": {
          "match": "*_fea",
          "mapping": {
            "type": "rank_feature"
          }
        }
      },
      {
        "rank_features": {
          "match": "*_feas",
          "mapping": {
            "type": "rank_features"
          }
        }
      },
      {
        "dense_vector": {
          "match": "*_512_vec",
          "mapping": {
            "type": "dense_vector",
            "index": true,
            "similarity": "cosine",
            "dims": 512
          }
        }
      },
      {
        "dense_vector": {
          "match": "*_768_vec",
          "mapping": {
            "type": "dense_vector",
            "index": true,
            "similarity": "cosine",
            "dims": 768
          }
        }
      },
      {
        "dense_vector": {
          "match": "*_1024_vec",
          "mapping": {
            "type": "dense_vector",
            "index": true,
            "similarity": "cosine",
            "dims": 1024
          }
        }
      },
      {
        "dense_vector": {
          "match": "*_1536_vec",
          "mapping": {
            "type": "dense_vector",
            "index": true,
            "similarity": "cosine",
            "dims": 1536
          }
        }
      },
      {
        "binary": {
          "match": "*_bin",
          "mapping": {
            "type": "binary"
          }
        }
      }
    ]
  }
}
